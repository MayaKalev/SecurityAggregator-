# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit it.

# --- OpenAI (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- NVD (optional) ---
# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it: rate limit is 5 requests / 30s. With it: 50 requests / 30s.
NVD_API_KEY=

# --- SMTP (optional) ---
# Powers send_critical_alert.
# For Gmail, SMTP_PASSWORD must be an app password, not your account
# password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mayakalev2001@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=mayakalev2001@gmail.com
EMAIL_TO=
